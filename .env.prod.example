# ===================
# Database
# ===================
# Strong password for PostgreSQL (generate one: openssl rand -base64 32)
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ===================
# Public URL
# ===================
# Your public-facing URL for the incentives dashboard
# Start with http://YOUR_VPS_IP, switch to https://incentives.yourdomain.com later
INCENTIVES_URL=http://YOUR_VPS_IP

# ===================
# Radix / Blockchain
# ===================
# DApp definition address on Radix mainnet
DAPP_DEFINITION_ADDRESS=account_rdx128df6qkch8ur5eyzmldkzu5t0nee3q3e2f6d0uf2xlvf6wllse62v0

# ===================
# API Keys (get these from your current deployment / team)
# ===================
# Token Price Service API key
TOKEN_PRICE_SERVICE_API_KEY=your_token_price_service_key

# ===================
# Admin JWT
# ===================
# Secret for admin dashboard session tokens (generate one: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
